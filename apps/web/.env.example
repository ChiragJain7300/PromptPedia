# Google OAuth Credentials
GOOGLE_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Backend API Configuration (Optional: set to connect directly to @promptpedia/api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEST_API_URL=http://localhost:4000/api/v1

# Standalone MongoDB Configuration (Used when running independently without @promptpedia/api)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

