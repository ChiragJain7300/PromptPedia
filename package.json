{
  "name": "promptpedia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:api": "npm run build --workspace=@promptpedia/api",
    "build:web": "npm run build --workspace=@promptpedia/web",
    "dev:api": "npm run start:dev --workspace=@promptpedia/api",
    "dev:web": "npm run dev --workspace=@promptpedia/web",
    "lint:api": "npm run lint --workspace=@promptpedia/api",
    "lint:web": "npm run lint --workspace=@promptpedia/web"
  }
}
